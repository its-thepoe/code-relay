{
  "name": "coderelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "export:test": "tsx apps/exporter-cli/src/index.ts",
    "export:migrate-job": "tsx scripts/export-migrate-job.ts",
    "export:compiled": "npm run build && node dist/apps/exporter-cli/src/index.js",
    "dev:web": "next dev apps/web -p 3000",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev": "npm run dev:web",
    "build:test": "tsc -p tsconfig.test.json && node scripts/write-test-package-json.cjs",
    "test": "npm run test:exporter",
    "test:exporter": "npm run build:test && node scripts/run-compiled-tests.cjs",
    "check:compiled-runtime": "npm run build && node scripts/check-compiled-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/archiver": "^6.0.3",
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.0",
    "next": "^15.5.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "slugify": "^1.6.6",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.15",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  }
}
